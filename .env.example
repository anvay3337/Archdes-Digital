# ==============================================================================
# Archdes Digital — Environment Configuration Template (.env.example)
# Copy this file to .env and provide your production secrets.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000

# Application Domain & Host Configuration
BUSINESS_NAME="Archdes Digital"
ALLOWED_ORIGINS="https://archdes.digital,https://www.archdes.digital,http://localhost:3000,http://localhost:5173"

# SMTP Email Configuration (Gmail App Password, Resend, SendGrid, Amazon SES, or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-app-password-or-api-key

# Notification & Auto-Reply Addresses
FROM_EMAIL=inquiries@archdes.digital
NOTIFY_EMAIL=archdesdigital@gmail.com
CONTACT_EMAIL=archdesdigital@gmail.com

# Rate Limiting & Abuse Prevention
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_SUBMISSIONS=5
